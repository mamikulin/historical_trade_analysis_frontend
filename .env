# API Configuration for Tauri
# For local testing with backend on same machine:
# Use 127.0.0.1 instead of localhost (Tauri WebView requirement)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_IMAGE_SERVER=http://127.0.0.1:9000

# For network testing (phone/other device), use your IP:
# VITE_API_BASE_URL=http://192.168.1.69:8000/api
# VITE_IMAGE_SERVER=http://192.168.1.69:9000
