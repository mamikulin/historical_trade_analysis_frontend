# API Configuration
# For local development with Vite proxy
VITE_API_BASE_URL=/api

# For Tauri build - use your local network IP
# Find your IP with: ipconfig getifaddr en0 (macOS) or ip addr show (Linux)
# Example:
# VITE_API_BASE_URL=http://192.168.1.100:8000/api
# VITE_IMAGE_SERVER=http://192.168.1.100:9000
